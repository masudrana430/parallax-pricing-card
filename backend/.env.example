DATABASE_URL=sqlite:///./astra.db
# For production: postgresql+psycopg://user:password@db:5432/astra
COOKIE_SECURE=false
# Optional: configure securely on the backend. Do not put a real key in git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
TRANSCRIPTION_MODEL=gpt-transcribe
# Render production: PostgreSQL is required; run python -m backend.migrate first.
APP_ENV=development
BACKEND_PROXY_SECRET=
# openai or ollama. Ollama requires your own reachable model server.
AI_PROVIDER=openai
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
